@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title telegram-webhook Edge Function - компоненты

Container_Boundary(webhook, "telegram-webhook") {
  Component(entry, "HTTP entry point", "index.ts", "Принимает только POST, ловит ошибки, возвращает Telegram HTTP 200 после обработки")
  Component(parser, "Парсер update", "lib/parse-update.ts", "Извлекает message, chatId и messageText")
  Component(validation, "Валидация сообщения", "lib/validate-message.ts", "Проверяет возможность ответа и сохранения")
  Component(env, "Доступ к environment", "lib/env.ts", "Читает BOT_TOKEN, SUPABASE_URL, SERVICE_ROLE, INTERNAL_SECRET")
  Component(botResolver, "Определение bot username", "lib/get-bot-username.ts", "Вызывает Telegram getMe и кеширует bot username")
  Component(persistence, "Сохранение входящего сообщения", "lib/save-incoming-message.ts", "Вызывает RPC process_incoming_telegram_message")
  Component(orchestratorInvoke, "Запуск AI orchestrator", "lib/invoke-ai-orchestrator.ts", "Best-effort background invoke через EdgeRuntime.waitUntil")
  Component(success, "Success response builder", "lib/create-success-response.ts", "Формирует стандартный Telegram-safe HTTP 200")
}

ContainerDb(db, "Supabase Postgres", "RPC")
Container(ai, "ai-orchestrator", "Edge Function")
System_Ext(telegramApi, "Telegram Bot API")

Rel(entry, env, "Читает runtime env")
Rel(entry, parser, "Парсит update")
Rel(entry, validation, "Валидирует message")
Rel(entry, botResolver, "Определяет bot username")
Rel(entry, persistence, "Сохраняет client message")
Rel(entry, orchestratorInvoke, "Планирует AI, если message inserted")
Rel(entry, success, "Возвращает 200")
Rel(botResolver, telegramApi, "getMe")
Rel(persistence, db, "POST /rest/v1/rpc/process_incoming_telegram_message", "service_role")
Rel(orchestratorInvoke, ai, "POST /functions/v1/ai-orchestrator", "internal secret + service_role")

note bottom of webhook
  Webhook не принимает support workflow decisions.
  Он сохраняет входящее client event и планирует backend AI orchestration.
end note

@enduml
